{
  "name": "ghpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:content": "tsx scripts/build-content.ts",
    "dev": "vite",
    "build": "tsx scripts/build-content.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "deploy": "npm run build && gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
